generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  role      String    @default("client")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  licenses  License[]
  products  Product[]
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  title       String
  description String?
  status      String   @default("w_kolejce")
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  version     String    @default("1.0.0")
  category    String    @default("Digital")
  downloadUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenses    License[]
}

model License {
  id         String    @id @default(cuid())
  licenseKey String    @unique
  name       String
  status     String    @default("active") // "active" | "expired" | "suspended"
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model SiteSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
